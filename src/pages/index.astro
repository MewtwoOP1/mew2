---
import '../styles/global.css';

const interests = [
  { icon: '✦', title: 'Anime & Manga', text: 'Stories, characters, worlds, and the occasional emotional damage.' },
  { icon: '</>', title: 'Coding', text: 'Learning, experimenting, and slowly turning ideas into things that actually work.' },
  { icon: '◌', title: 'Creative Stuff', text: 'Edits, wallpapers, aesthetics, and anything that makes the internet feel a little nicer.' },
  { icon: '⌁', title: 'Big Goals', text: 'Still figuring out the route. The destination is definitely somewhere interesting.' }
];

const currently = [
  ['Status', 'building something'],
  ['Learning', 'coding'],
  ['Watching', 'anime'],
  ['Vibe', 'sakura nights 🌸']
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0a0910" />
  <meta name="description" content="Goutam's little corner of the internet." />
  <title>Goutam — little corner of the internet</title>
</head>
<body>
  <div class="noise"></div>
  <div class="orb orb-a"></div>
  <div class="orb orb-b"></div>

  <header class="site-header shell">
    <a class="brand" href="#top" aria-label="Goutam home">
      <span class="brand-mark">G</span>
      <span>goutam</span>
    </a>
    <nav>
      <a href="#about">about</a>
      <a href="#interests">interests</a>
      <a href="#now">now</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero shell">
      <div class="hero-copy">
        <div class="eyebrow"><span class="dot"></span> welcome to my little corner</div>
        <h1>Hi, I'm <span>Goutam.</span></h1>
        <p class="hero-sub">Student. Otaku. Introvert.<br />Learning to build things worth remembering.</p>
        <p class="hero-note">A quiet place for anime, ideas, code, and whatever comes next.</p>
        <div class="actions">
          <a class="button primary" href="#about">explore <span>↘</span></a>
          <a class="button ghost" href="https://github.com/" target="_blank" rel="noreferrer">github ↗</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="moon"></div>
        <div class="halo"></div>
        <div class="petal p1">✿</div>
        <div class="petal p2">✿</div>
        <div class="petal p3">✿</div>
        <div class="petal p4">✿</div>
        <div class="petal p5">✿</div>
        <div class="branch">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="star s1">✦</div>
        <div class="star s2">·</div>
        <div class="star s3">✦</div>
      </div>
    </section>

    <section id="about" class="section shell">
      <div class="section-kicker">01 / about</div>
      <div class="section-grid">
        <h2>Just a guy<br /><em>figuring things out.</em></h2>
        <div class="body-copy">
          <p>I'm Goutam, a student who likes anime, manga, technology, and the idea of eventually building something genuinely big.</p>
          <p>I'm naturally more on the quiet side. I spend a lot of time exploring ideas, learning new stuff, and getting distracted by an anime that was supposed to be “just one episode.”</p>
          <p>This site is simply my little space on the internet. No corporate biography. No inspirational stock photo of a mountain. Just me.</p>
        </div>
      </div>
    </section>

    <section id="interests" class="section shell">
      <div class="section-kicker">02 / things I like</div>
      <div class="cards">
        {interests.map((item) => (
          <article class="card">
            <div class="card-icon">{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="now" class="section shell">
      <div class="section-kicker">03 / currently</div>
      <div class="now-layout">
        <div>
          <h2>Right now.</h2>
          <p class="muted">A tiny snapshot. Humans apparently enjoy documenting what they are doing every five minutes.</p>
        </div>
        <div class="now-list">
          {currently.map(([label, value]) => (
            <div class="now-row"><span>{label}</span><strong>{value}</strong></div>
          ))}
        </div>
      </div>
    </section>

    <section class="closing shell">
      <div class="closing-card">
        <div class="closing-petal">🌸</div>
        <h2>See you somewhere<br /><span>under the sakura.</span></h2>
        <p>Still learning. Still dreaming. Still going.</p>
        <a class="text-link" href="https://github.com/" target="_blank" rel="noreferrer">find me on github ↗</a>
      </div>
    </section>
  </main>

  <footer class="shell footer">
    <span>© 2026 Goutam</span>
    <span>made with too much caffeine & 🌸</span>
  </footer>

  <script>
    const petals = [...document.querySelectorAll('.petal')];
    let mx = 0, my = 0;
    window.addEventListener('pointermove', (e) => {
      mx = (e.clientX / window.innerWidth - 0.5);
      my = (e.clientY / window.innerHeight - 0.5);
      petals.forEach((petal, i) => {
        const strength = (i + 1) * 3;
        petal.style.transform = `translate(${mx * strength}px, ${my * strength}px) rotate(${i * 17}deg)`;
      });
    }, { passive: true });
  </script>
</body>
</html>
